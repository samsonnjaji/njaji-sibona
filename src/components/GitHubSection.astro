---
import { site } from "../data/site";
---
<section id="github" class="github-section section" aria-labelledby="github-heading">
  <div class="container gh-layout">
    <div>
      <p class="section-kicker">06 / OPEN SOURCE</p>
      <h2 id="github-heading" class="section-title">Code you can <span>explore.</span></h2>
      <p class="section-lead">I share selected public engineering work on GitHub. Client projects and unpublished research remain private.</p>
    </div>
    <div class="gh-card">
      <div class="gh-card-top"><span class="gh-symbol" aria-hidden="true">&lt;/&gt;</span><span>PUBLIC WORK</span></div>
      <h3>Follow the work, not just the headlines.</h3>
      <p>Browse repositories, review the code and see how projects evolve through practical engineering.</p>
      <a href={site.social.github} target="_blank" rel="noopener noreferrer">Explore my GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
<style>
.github-section{padding:80px 0;border-top:1px solid var(--border);background:linear-gradient(180deg,#0a1728,#07121f)}
.gh-layout{display:grid;grid-template-columns:.9fr 1.1fr;gap:65px;align-items:center}
.github-section .section-title span{color:#8ebfe8}
.gh-card{border:1px solid #668cb24f;padding:33px;border-radius:18px;background:radial-gradient(circle at 100% 0,#214a6950,transparent 64%),#102035}
.gh-card-top{display:flex;align-items:center;gap:16px;font:700 10px var(--font-mono);color:#89b3cf;letter-spacing:.15em}
.gh-symbol{display:flex;width:51px;height:51px;align-items:center;justify-content:center;background:#75d3ee15;border:1px solid #6cd8ef50;border-radius:12px;color:#88def2;font-size:17px;font-weight:700}
.gh-card h3{font-size:clamp(22px,2.8vw,29px);line-height:1.2;letter-spacing:-.04em;margin:24px 0 12px}
.gh-card p{font-size:14px;color:var(--text-muted);margin:0 0 25px;line-height:1.75}
.gh-card a{font-size:13px;font-weight:750;display:inline-flex;align-items:center;gap:18px}
@media(max-width:780px){.gh-layout{grid-template-columns:1fr;gap:25px}.github-section{padding:60px 0}.gh-card{padding:26px}}
</style>