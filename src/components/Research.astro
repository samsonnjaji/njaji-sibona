---
const questions = [
 "How do systems learn reliably from new experiences?",
 "What makes intelligent behaviour useful and verifiable?",
 "How can software and AI remain efficient and dependable?"
];
---
<section id="research" class="research-section section" aria-labelledby="research-title">
 <div class="container">
  <p class="section-kicker">03 / INDEPENDENT EXPLORATION</p>
  <div class="research-shell">
   <div class="research-main">
    <p class="research-label">SIBONA AI <span> / RESEARCH DIRECTION</span></p>
    <h2 id="research-title">Curiosity, made <em>testable.</em></h2>
    <p>I explore questions around learning, perception and intelligent software systems. The work is early-stage: ideas are hypotheses until careful experiments establish what holds up.</p>
    <p class="discretion">Some experiments and implementation details are intentionally unpublished.</p>
    <a href="#contact" class="research-link">Discuss research collaboration <span aria-hidden="true">↗</span></a>
   </div>
   <div class="research-aside">
     <div class="diagram" aria-hidden="true"><span class="node a"></span><span class="node b"></span><span class="node c"></span><span class="node d"></span><span class="node e"></span><span class="node f"></span><span class="connection"></span><span class="signal">RESEARCH / EXPERIMENT / EVIDENCE</span></div>
     <p class="questions-title">QUESTIONS I'M EXPLORING</p>
     <ul>{questions.map(q => <li><span aria-hidden="true">↗</span>{q}</li>)}</ul>
   </div>
  </div>
 </div>
</section>
<style>
.research-section{padding:92px 0;background:#081523;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.research-shell{display:grid;grid-template-columns:1.15fr .85fr;border:1px solid #4e83a94c;border-radius:24px;overflow:hidden;background:radial-gradient(circle at 30% 45%,#1a3c5f77,transparent 58%),#0c1a2a;box-shadow:0 24px 90px #0004}
.research-main{padding:clamp(35px,5vw,72px)}.research-label{font-size:13px;color:#75dcf2;letter-spacing:.18em;font-weight:750}
.research-label span{color:#7892ac}h2{font-size:clamp(2.55rem,5vw,5rem);letter-spacing:-.06em;line-height:1.06;margin:36px 0 25px;max-width:690px}
h2 em{font-style:normal;color:#78b9eb}.research-main>p:not(.research-label){color:#afc0d5;max-width:580px;font-size:16px;line-height:1.8}
.discretion{font-size:13px!important;color:#83a0bd!important}.research-link{display:inline-flex;margin-top:18px;font-size:14px;font-weight:750;gap:20px;padding-bottom:7px;border-bottom:1px solid #70b6e4}
.research-aside{padding:30px 34px;background:#07101e66;border-left:1px solid #5589ac38;display:flex;flex-direction:column;justify-content:center}
.diagram{height:205px;position:relative;background:radial-gradient(circle at 50% 50%,#46aad22e,transparent 60%);overflow:hidden;border-bottom:1px solid #699ac433}
.node{position:absolute;width:9px;height:9px;border-radius:50%;background:#68d9f4;box-shadow:0 0 17px #4bd1ed}.a{top:30%;left:23%}.b{top:65%;left:43%}.c{top:19%;left:61%}.d{top:58%;left:73%}.e{top:44%;left:53%;width:17px;height:17px}.f{top:75%;left:15%}
.connection{position:absolute;inset:12% 9%;background:linear-gradient(29deg,transparent 43%,#69bbe634 44%,#69bbe634 44.5%,transparent 45%),linear-gradient(154deg,transparent 49%,#69bbe635 49.5%,#69bbe635 50%,transparent 50.5%),linear-gradient(95deg,transparent 50%,#69bbe635 50.5%,transparent 51%);border:1px solid #80dfff13;border-radius:50%}
.signal{position:absolute;bottom:15px;right:5px;font-family:var(--font-mono);letter-spacing:.13em;color:#6a9db9;font-size:9px}
.questions-title{font-family:var(--font-mono);letter-spacing:.15em;font-size:10px;color:#7f9fb5;margin:24px 0 12px}.research-aside ul{padding:0;list-style:none;margin:0}
.research-aside li{display:flex;gap:12px;padding:10px 0;border-bottom:1px solid #91bddd17;font-size:13px;color:#cbdae8;line-height:1.55}.research-aside li:last-child{border:0}.research-aside li span{color:#74cbef}
@media(max-width:800px){.research-shell{grid-template-columns:1fr}.research-aside{border-left:0;border-top:1px solid #5589ac38}.research-section{padding:70px 0}}
</style>