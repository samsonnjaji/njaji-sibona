---
import { site } from "../data/site";
---
<section id="top" class="hero" aria-labelledby="hero-heading">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> SOFTWARE ENGINEER / FOUNDER / EXPLORER</p>
      <h1 id="hero-heading">Engineering <span>what matters.</span><br />Exploring what's <em>next.</em></h1>
      <p class="hero-lead">I'm <strong>Samson Sibona Njaji</strong> — a software engineer and co-founder & CTO of SIONA Technologies. I build practical digital systems and explore applied intelligence with a research-first mindset.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">Explore my work <span aria-hidden="true">↗</span></a>
        <a class="button button-secondary" href={"mailto:" + site.email}>Let's talk <span aria-hidden="true">→</span></a>
      </div>
      <div class="proof">
        <div><span class="proof-top">Software engineering</span><span class="proof-label">Products, APIs & cloud</span></div>
        <div><span class="proof-top">Applied AI</span><span class="proof-label">Independent exploration</span></div>
        <div><span class="proof-top">Nairobi, Kenya</span><span class="proof-label">Open to global collaboration</span></div>
      </div>
    </div>
    <div class="hero-art">
      <div class="art-halo" aria-hidden="true"></div>
      <div class="portrait-frame">
        <img src={site.avatar} alt="Portrait of Samson Sibona Njaji" width="620" height="760" decoding="async" fetchpriority="high" />
      </div>
      <div class="floating-tag tag-top"><span class="tag-icon" aria-hidden="true">◈</span><span>BUILDING FOR IMPACT <small>Engineering with purpose</small></span></div>
      <div class="floating-tag tag-bottom"><span class="online-dot" aria-hidden="true"></span><span>Available for meaningful collaborations</span></div>
    </div>
  </div>
  <div class="hero-bottom container"><span>PORTFOLIO — 2026</span><span>SCROLL TO EXPLORE <span aria-hidden="true">↓</span></span></div>
</section>
<style>
.hero{position:relative;overflow:hidden;background:radial-gradient(ellipse 50% 70% at 75% 34%,#1a325a66,transparent 75%),linear-gradient(135deg,#07101d,#071526 72%,#091525);border-bottom:1px solid var(--border)}
.hero::before{content:"";position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(#a3dfff08 1px,transparent 1px),linear-gradient(90deg,#a3dfff08 1px,transparent 1px);background-size:64px 64px;mask-image:linear-gradient(90deg,transparent 15%,black 95%)}
.hero-grid{position:relative;display:grid;grid-template-columns:1.04fr .96fr;gap:3rem;align-items:center;min-height:695px}
.hero-copy{position:relative;z-index:2;padding:95px 0 100px}
.eyebrow{display:flex;align-items:center;gap:10px;color:#a9c8ed;letter-spacing:.2em;font-size:11px;font-weight:700;margin:0 0 25px}
.status-dot{width:8px;height:8px;background:#59e0c5;border-radius:50%;box-shadow:0 0 0 5px #59e0c516}
h1{font-size:clamp(3.2rem,5.35vw,5.7rem);line-height:1.04;letter-spacing:-.065em;margin:0 0 28px;max-width:720px;font-weight:750}
h1 span{color:#eef5ff}h1 em{font-style:normal;background:linear-gradient(100deg,#81b5ff,#60e4ef);background-clip:text;-webkit-background-clip:text;color:transparent}
.hero-lead{font-size:17px;line-height:1.8;color:#adbcd1;max-width:565px;margin:0 0 31px}.hero-lead strong{color:#eef5ff;font-weight:650}
.hero-actions{display:flex;flex-wrap:wrap;gap:12px}.button{display:inline-flex;justify-content:center;align-items:center;gap:22px;padding:14px 21px;border:1px solid #5b7292;border-radius:9px;font-size:13px;font-weight:750;transition:transform .2s ease,filter .2s ease}.button:hover{transform:translateY(-2px)}
.button-primary{color:#041427;background:linear-gradient(95deg,#7dabff,#5ddfec);border-color:transparent}.button-primary:hover{color:#041427;filter:brightness(1.1)}
.button-secondary{color:#eff8ff;background:#ffffff06}
.proof{margin-top:62px;padding-top:24px;border-top:1px solid #9ebde522;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}
.proof>div{border-right:1px solid #9ebde522;padding-right:14px}.proof>div:last-child{border:0}
.proof-top,.proof-label{display:block}.proof-top{color:#f2f6ff;font-weight:700;font-size:14px}.proof-label{font-size:11px;color:#8194ac;margin-top:5px}
.hero-art{position:relative;align-self:stretch;min-height:560px;display:flex;justify-content:center;align-items:end}
.art-halo{position:absolute;inset:10% -5% 9%;background:radial-gradient(circle,#3c74d855,transparent 68%);filter:blur(12px)}
.portrait-frame{position:relative;height:90%;max-height:685px;width:94%;border-radius:180px 180px 0 0;background:linear-gradient(145deg,#31599c,#0d1d32 70%);border:1px solid #87afe633;overflow:hidden;box-shadow:0 30px 80px #0005}
.portrait-frame::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,transparent 70%,#071525a0)}
.portrait-frame img{height:100%;width:100%;object-fit:cover;object-position:center 24%;display:block}
.floating-tag{position:absolute;z-index:3;display:flex;align-items:center;gap:10px;padding:14px 16px;background:#101d32dd;border:1px solid #aacaff3a;border-radius:13px;box-shadow:0 16px 40px #0006;backdrop-filter:blur(14px);font-size:11px;letter-spacing:.03em;font-weight:700}
.floating-tag small{display:block;margin-top:5px;font-weight:400;font-size:11px;color:#a0b0ca}
.tag-icon{color:#6cddf5;font-size:26px}.tag-top{top:22%;right:-4%}.tag-bottom{bottom:9%;left:-10%;padding:13px}
.online-dot{height:8px;width:8px;display:inline-block;background:#66deb5;border-radius:50%}
.hero-bottom{position:relative;display:flex;justify-content:space-between;padding:0 0 24px;color:#6c819b;letter-spacing:.19em;font-family:var(--font-mono);font-size:10px}
@media(max-width:1100px){.hero-grid{gap:1rem}.tag-top{right:0}.tag-bottom{left:0}.proof{margin-top:35px}}
@media(max-width:820px){.hero-grid{grid-template-columns:1fr;gap:0}.hero-copy{padding:72px 0 20px}h1{max-width:650px;font-size:clamp(2.9rem,9vw,4.5rem)}.hero-art{height:480px;min-height:480px;max-width:510px;width:100%;margin:auto}.portrait-frame{height:100%;width:80%}.tag-top{right:0;top:17%}.tag-bottom{left:0;bottom:9%}.proof{margin-top:32px}.hero-bottom{padding-top:10px}}
@media(max-width:560px){.hero-copy{padding-top:49px}.eyebrow{font-size:9px;letter-spacing:.13em}h1{font-size:clamp(2.6rem,11vw,4rem)}.hero-lead{font-size:15px}.proof{grid-template-columns:1fr 1fr;gap:18px}.proof>div:nth-child(2){border:0}.hero-art{height:370px;min-height:370px;margin-top:32px}.portrait-frame{width:87%;border-radius:120px 120px 0 0}.tag-top{top:16%;right:-2%;font-size:9px;max-width:175px}.tag-bottom{bottom:8%;font-size:9px;max-width:220px}.hero-bottom{font-size:8px}}
@media(prefers-reduced-motion:reduce){.button{transition:none}.button:hover{transform:none}}
</style>