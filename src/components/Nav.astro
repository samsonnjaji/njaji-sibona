---
import { site } from "../data/site";
const links = [
 { href: "#about", label: "About" },
 { href: "#work", label: "Work" },
 { href: "#research", label: "Research" },
 { href: "#journey", label: "Journey" },
 { href: "#skills", label: "Skills" },
 { href: "#contact", label: "Contact" }
];
---
<header class="site-header">
  <nav class="site-nav container" aria-label="Primary navigation">
    <a href="#top" class="wordmark" aria-label="Samson Sibona Njaji — Home"><span class="mark">S<span>.</span></span><span class="wordmark-name">SIBONA<small>ENGINEER / RESEARCHER</small></span></a>
    <ul class="desktop-links">
      {links.map(link => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
    <a class="nav-action" href={"mailto:" + site.email}>Let's connect <span aria-hidden="true">↗</span></a>
    <details class="mobile-menu">
      <summary aria-label="Toggle navigation">Menu <span aria-hidden="true">☰</span></summary>
      <ul>{links.map(link => <li><a href={link.href}>{link.label}</a></li>)}</ul>
    </details>
  </nav>
</header>
<style>
.site-header{position:sticky;top:0;z-index:40;background:rgba(6,12,23,.87);backdrop-filter:blur(20px);border-bottom:1px solid var(--border)}
.site-nav{min-height:78px;display:flex;align-items:center;gap:30px}
.wordmark{display:inline-flex;gap:12px;align-items:center;color:var(--text);text-decoration:none;flex-shrink:0}
.mark{font-size:30px;font-weight:800;letter-spacing:-.08em;line-height:1}.mark span{color:var(--accent)}
.wordmark-name{font-size:12px;letter-spacing:.18em;font-weight:800;line-height:1.35}.wordmark-name small{display:block;color:var(--text-dim);font-size:8px;letter-spacing:.16em}
.desktop-links{display:flex;align-items:center;gap:23px;list-style:none;margin:0 auto;padding:0}
.desktop-links a{font-size:13px;color:var(--text-muted);font-weight:600}
.desktop-links a:hover{color:var(--text)}
.nav-action{white-space:nowrap;font-size:13px;font-weight:700;color:#06101e;background:linear-gradient(110deg,#88b8ff,#49dcf0);border-radius:8px;padding:11px 17px}
.nav-action:hover{color:#06101e;filter:brightness(1.1)}
.mobile-menu{display:none;position:relative}
.mobile-menu summary{cursor:pointer;list-style:none;padding:9px 12px;border:1px solid var(--border-strong);border-radius:8px;font-weight:600}
.mobile-menu summary::-webkit-details-marker{display:none}
.mobile-menu ul{position:absolute;top:100%;right:0;width:205px;list-style:none;background:#0a1425;border:1px solid var(--border-strong);border-radius:12px;padding:10px 14px;box-shadow:0 24px 50px #0009}
.mobile-menu li a{display:block;padding:10px 3px;color:var(--text)}
@media(max-width:980px){.desktop-links{gap:12px}.desktop-links a{font-size:12px}}
@media(max-width:760px){.site-nav{min-height:69px}.desktop-links,.nav-action{display:none}.mobile-menu{display:block;margin-left:auto}}
</style>