---
import { projects } from "../data/site";
const hasLink = (p: typeof projects[number]): p is typeof projects[number] & { primaryUrl: string; primaryLabel: string } =>
  "primaryUrl" in p && typeof p.primaryUrl === "string";
---
<section id="work" class="work-section section" aria-labelledby="work-title">
 <div class="container">
  <div class="work-heading">
   <div><p class="section-kicker">02 / SELECTED WORK</p><h2 id="work-title" class="section-title">Things I've built <span>& helped shape.</span></h2><p class="section-lead">Practical products, company-building and selected engineering work.</p></div>
   <a href="https://github.com/samsonnjaji" target="_blank" rel="noopener noreferrer" class="browse">Browse GitHub <span aria-hidden="true">↗</span></a>
  </div>
  <div class="work-grid">
   {projects.map((project, index) => (
    <article class:list={["project-card", index === 0 && "featured"]}>
     <div class:list={["project-visual", "visual-" + index]} aria-hidden="true">
      <div class="visual-ring"></div><span>{String(index + 1).padStart(2,"0")}</span><div class="visual-symbol">{index===0?"V":index===1?"S":index===2?"AI":"{ }"}</div>
     </div>
     <div class="project-content">
      <p class="project-category">{project.category}</p>
      <h3>{project.title}</h3><p class="project-desc">{project.description}</p>
      <ul class="tag-list">{project.tags.map(tag => <li>{tag}</li>)}</ul>
      {hasLink(project) ?
       <a href={project.primaryUrl} target="_blank" rel="noopener noreferrer" class="project-link">{project.primaryLabel} <span aria-hidden="true">↗</span></a>
      : <span class="project-note">{"nda" in project ? "Confidential engagement" : "Exploration in progress"}</span>}
     </div>
    </article>
   ))}
  </div>
 </div>
</section>
<style>
.work-section{padding:94px 0}.work-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:30px}.work-heading .section-title span{color:#79afdc}.browse{white-space:nowrap;font-size:13px;font-weight:750;margin-bottom:17px}.work-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:17px}
.project-card{grid-column:span 2;border:1px solid var(--border-strong);background:#0e1929;border-radius:16px;overflow:hidden;display:flex;flex-direction:column;transition:transform .2s,border-color .2s}
.project-card:nth-child(1),.project-card:nth-child(2){grid-column:span 3}.project-card:hover{border-color:#5085b87a;transform:translateY(-3px)}
.project-visual{position:relative;height:172px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:radial-gradient(circle at 70% 15%,#4972ba88,transparent 65%),linear-gradient(150deg,#0e2341,#071627)}
.project-card:nth-child(-n+2) .project-visual{height:220px}.visual-1{background:radial-gradient(circle at 70% 35%,#307ab377,transparent 65%),linear-gradient(145deg,#112134,#081018)}
.visual-2{background:radial-gradient(circle at 50% 40%,#3458aa77,transparent 65%),linear-gradient(145deg,#17223f,#0b1530)}
.visual-3,.visual-4{background:radial-gradient(circle at 75% 45%,#2e8b9170,transparent 65%),linear-gradient(145deg,#0b2432,#081421)}
.visual-ring{width:150px;height:150px;border:1px solid #95d8ff4c;border-radius:50%;box-shadow:0 0 0 27px #8bd6fe13,0 0 0 54px #8bd6fe08;position:absolute;transform:rotate(-27deg) skew(14deg)}
.project-visual>span{position:absolute;left:22px;top:17px;color:#9bb9dc;font-size:11px;font-family:var(--font-mono);letter-spacing:.15em}
.visual-symbol{font-size:60px;font-weight:800;letter-spacing:-.1em;color:#def8ff;text-shadow:0 0 40px #4cadff80}.visual-2 .visual-symbol{font-size:45px;letter-spacing:-.05em}
.project-content{padding:25px;display:flex;flex:1;flex-direction:column}.project-category{font-family:var(--font-mono);text-transform:uppercase;letter-spacing:.12em;font-size:10px;color:#7bc2e9;margin:0 0 9px}
.project-content h3{margin:0 0 11px;font-size:22px;line-height:1.2;letter-spacing:-.03em}.project-desc{color:var(--text-muted);font-size:14px;line-height:1.75;margin:0 0 20px;flex:1}.tag-list{display:flex;flex-wrap:wrap;gap:6px;list-style:none;margin:0 0 18px;padding:0}
.tag-list li{border:1px solid #8eade531;padding:4px 8px;border-radius:5px;font-size:10px;color:#aebfd4}.project-link,.project-note{align-self:flex-start;font-size:12px;font-weight:750;color:#77cde9}.project-link span{margin-left:8px}.project-note{color:#8399b5}
@media(max-width:850px){.project-card,.project-card:nth-child(1),.project-card:nth-child(2){grid-column:span 3}.work-section{padding:70px 0}}
@media(max-width:590px){.work-heading{align-items:start;flex-direction:column}.browse{margin:0}.project-card,.project-card:nth-child(1),.project-card:nth-child(2){grid-column:span 6}.project-card:nth-child(-n+2) .project-visual{height:180px}}
@media(prefers-reduced-motion:reduce){.project-card{transition:none}.project-card:hover{transform:none}}
</style>