---
import { site } from "../data/site";
---
<section id="contact" class="contact-section section" aria-labelledby="contact-title">
 <div class="container contact-shell">
  <p class="section-kicker">07 / GET IN TOUCH</p>
  <h2 id="contact-title">Let's build something <em>worth building.</em></h2>
  <p>Interested in engineering collaboration, applied research, software projects or technical mentorship? I'd be glad to connect.</p>
  <a class="contact-button" href={"mailto:" + site.email}>Start a conversation <span aria-hidden="true">↗</span></a>
  <div class="contact-links">
   <a href={site.social.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
   <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
   <a href={site.social.credlyProfile} target="_blank" rel="noopener noreferrer">Credentials ↗</a>
  </div>
 </div>
</section>
<style>
.contact-section{padding:105px 0}.contact-shell{text-align:center;border:1px solid #5089b05a;background:radial-gradient(ellipse at 50% 0,#2b51765f,transparent 65%),#0b1a2b;border-radius:26px;padding:70px 30px}
.contact-shell .section-kicker{text-align:center}.contact-shell h2{max-width:820px;margin:15px auto 20px;font-size:clamp(2.6rem,5.8vw,5.8rem);line-height:1.05;letter-spacing:-.055em}
.contact-shell h2 em{font-style:normal;color:#82c8ea}.contact-shell>p:not(.section-kicker){max-width:650px;margin:0 auto 29px;color:#b1c2d8;font-size:16px;line-height:1.75}
.contact-button{display:inline-flex;gap:30px;background:linear-gradient(100deg,#81b6ff,#68e0e7);color:#061524;padding:16px 23px;border-radius:10px;font-weight:800;font-size:14px}.contact-button:hover{color:#061524}
.contact-links{display:flex;justify-content:center;flex-wrap:wrap;gap:25px;margin-top:30px}.contact-links a{font-size:13px;color:#b6cbe1}
@media(max-width:600px){.contact-section{padding:60px 0}.contact-shell{padding:50px 20px}.contact-links{gap:16px}}
</style>