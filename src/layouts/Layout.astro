---
import "../styles/global.css";
const canonical = "https://njaji-sibona.pages.dev/";
const title = "Samson Sibona Njaji | Software Engineer, Co-founder & CTO";
const description = "Samson Sibona Njaji — software engineer, co-founder and CTO of SIONA Technologies, and an applied AI explorer. Practical systems and selected engineering work.";
const person = {
  "@context": "https://schema.org", "@type": "Person",
  "name": "Samson Sibona Njaji", "url": canonical, "jobTitle": "Software Engineer, Co-founder and CTO, Applied AI Explorer",
  "sameAs": ["https://github.com/samsonnjaji","https://www.linkedin.com/in/njaji-sibona"],
  "affiliation": {"@type": "Organization","name":"SIONA Technologies","url":"https://sionaglobal.com"}
};
---
<!doctype html>
<html lang="en" data-theme="light">
 <head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#f7f8f5" />
  <meta name="description" content={description} />
  <meta property="og:type" content="profile" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL("/assets/samson-portrait.webp", canonical).href} />
  <meta property="og:image:alt" content="Samson Sibona Njaji, software engineer and co-founder" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL("/assets/samson-portrait.webp", canonical).href} />
  <link rel="icon" href="/favicon.ico?v=sibona" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=sibona" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=sibona" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=sibona" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=sibona" />
  <link rel="canonical" href={canonical} />
  <script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, "\\u003c")} />
  <title>{title}</title>
 </head>
 <body>
  <slot />
 </body>
</html>
